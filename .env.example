# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env real no Git!

# Chave da API da Anthropic
# Pegue em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-COLE-SUA-CHAVE-AQUI

# Porta onde o servidor vai rodar
PORT=3000

# Modelo da Claude a ser usado
# Opções: claude-haiku-4-5-20251001 (rápido e barato, recomendado)
#         claude-sonnet-4-6 (mais inteligente, mais caro)
CLAUDE_MODEL=claude-haiku-4-5-20251001
